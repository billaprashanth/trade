# Password for the /admin dashboard (required to add / edit / delete trades)
ADMIN_PASSWORD=change-me

# Database (Upstash Redis). On Vercel: Storage -> Marketplace -> Upstash Redis -> Connect.
# Vercel fills these in automatically. Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to preview the site with clearly-labelled SAMPLE trades while you have no real trades.
SHOW_SAMPLE_DATA=false
